{
  "$schema": "https://raw.githubusercontent.com/nicepkg/tauri-schema/main/schemas/config-v2.json",
  "productName": "DroidFrost",
  "version": "1.0.0",
  "identifier": "com.droidfrost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DroidFrost - Android Optimizer & Freeze Engine",
        "width": 1150,
        "height": 760,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
